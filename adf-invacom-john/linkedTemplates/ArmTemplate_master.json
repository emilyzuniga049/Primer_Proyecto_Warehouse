{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-invacom-john"
		},
		"ls_azuresql_dw_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_azuresql_dw'"
		},
		"ls_azuresql_fuente_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_azuresql_fuente'"
		},
		"ls_azuresql_dw_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-invacom-john.database.windows.net"
		},
		"ls_azuresql_dw_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-invacom-dw"
		},
		"ls_azuresql_dw_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "invacomadmin"
		},
		"ls_azuresql_fuente_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-invacom-john.database.windows.net"
		},
		"ls_azuresql_fuente_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-invacom-fuente"
		},
		"ls_azuresql_fuente_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "invacomadmin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-invacom-john_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_azuresql_dw_password": {
						"value": "[parameters('ls_azuresql_dw_password')]"
					},
					"ls_azuresql_fuente_password": {
						"value": "[parameters('ls_azuresql_fuente_password')]"
					},
					"ls_azuresql_dw_properties_typeProperties_server": {
						"value": "[parameters('ls_azuresql_dw_properties_typeProperties_server')]"
					},
					"ls_azuresql_dw_properties_typeProperties_database": {
						"value": "[parameters('ls_azuresql_dw_properties_typeProperties_database')]"
					},
					"ls_azuresql_dw_properties_typeProperties_userName": {
						"value": "[parameters('ls_azuresql_dw_properties_typeProperties_userName')]"
					},
					"ls_azuresql_fuente_properties_typeProperties_server": {
						"value": "[parameters('ls_azuresql_fuente_properties_typeProperties_server')]"
					},
					"ls_azuresql_fuente_properties_typeProperties_database": {
						"value": "[parameters('ls_azuresql_fuente_properties_typeProperties_database')]"
					},
					"ls_azuresql_fuente_properties_typeProperties_userName": {
						"value": "[parameters('ls_azuresql_fuente_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}